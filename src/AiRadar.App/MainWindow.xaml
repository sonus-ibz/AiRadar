<Window x:Class="AiRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AiRadar.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AI Radar" Height="720" Width="1000" MinWidth="640" MinHeight="420"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource InkBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AI Radar" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding AiStatusText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Settings" Style="{StaticResource QuietButton}" Command="{Binding ToggleSettingsCommand}" Margin="0,0,8,0" />
                <Button Content="Check now" Style="{StaticResource PrimaryButton}" Command="{Binding CheckNowCommand}" />
            </StackPanel>
        </Grid>

        <!-- Settings: Product Hunt token -->
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Product Hunt token" FontWeight="SemiBold" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10">
                    AI Radar reads new AI launches through Product Hunt's free API. Create an application at
                    <Hyperlink NavigateUri="https://www.producthunt.com/v2/oauth/applications" RequestNavigate="OnHyperlinkRequestNavigate">producthunt.com/v2/oauth/applications</Hyperlink>,
                    copy its developer token and paste it here. It is stored encrypted for your Windows account only.
                </TextBlock>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveTokenClick" Margin="8,0,0,0" />
                    <PasswordBox x:Name="TokenBox" Padding="6" AutomationProperties.Name="Product Hunt developer token" />
                </DockPanel>

                <TextBlock Text="Minimum popularity" FontWeight="SemiBold" FontSize="16" Margin="0,18,0,0" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"
                           Text="Tools below these numbers are hidden, not deleted. Lower a number to see more, raise it to see less." />
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="Width" Value="70" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="6,0,24,8" />
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </WrapPanel.Resources>
                    <TextBlock Text="Product Hunt votes" />
                    <TextBox Text="{Binding ProductHuntMinVotes}" AutomationProperties.Name="Minimum Product Hunt votes" />
                    <TextBlock Text="Hacker News points" />
                    <TextBox Text="{Binding HackerNewsMinPoints}" AutomationProperties.Name="Minimum Hacker News points" />
                    <TextBlock Text="Hugging Face likes" />
                    <TextBox Text="{Binding HuggingFaceMinLikes}" AutomationProperties.Name="Minimum Hugging Face likes" />
                    <TextBlock Text="GitHub stars" />
                    <TextBox Text="{Binding GitHubMinStars}" AutomationProperties.Name="Minimum GitHub stars" />
                </WrapPanel>

                <TextBlock Text="Local AI sorting (experimental)" FontWeight="SemiBold" FontSize="16" Margin="0,10,0,0" />
                <CheckBox IsChecked="{Binding UseLocalAi}" Margin="0,6,0,0" VerticalContentAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Text="Re-sort the tools you see with a free AI model on this PC (needs Ollama with llama3.2:3b)." />
                </CheckBox>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="20,4,0,10" FontSize="12"
                           Text="Off by default: on a test of 95 hand-checked tools, this model sorted 76% right against 84% for the built-in keyword rules. Turning it off puts AI-sorted tools back on keyword categories." />

                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveFiltersCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,18,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                <RadioButton Content="Products" Style="{StaticResource FeedTab}" IsChecked="True" />
                <RadioButton Content="For developers" Style="{StaticResource FeedTab}" Margin="6,0,0,0"
                             IsChecked="{Binding IsDeveloperFeed, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Good at: categories with counts -->
        <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GOOD AT" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="14,12,0,6" />
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Categories">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItem}">
                            <DockPanel Margin="6,3">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Tool list -->
        <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <ListBox x:Name="ToolList" ItemsSource="{Binding Tools}" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnToolDoubleClick" AutomationProperties.Name="AI tools">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolRow}">
                        <Grid Margin="6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <Border Background="{StaticResource GoodSoftBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoodBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Tagline}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Categories}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </Grid>
    </Grid>
</Window>
